# Required. Neon (or local) Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sync_api_test

# Same names as workers/sync-hub.
# PWM fork: leave empty and set LOCAL_TOKEN_SHA256 (JSON map of sha256(device token) -> user id).
TOKEN_VERIFY_URL=
LOCAL_TOKEN_SHA256=
AUTH_CACHE_TTL_SECONDS=900
INTERNAL_PROJECTOR_URL=
CMEM_INTERNAL_PROJECTOR_SECRET=

# Listen. Fly sets PORT; default matches fly.toml internal_port.
PORT=8080
HOST=0.0.0.0
